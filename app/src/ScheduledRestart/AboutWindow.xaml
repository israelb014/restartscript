<Window x:Class="ScheduledRestart.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אודות" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextBrush}">
    <Border Margin="18" Style="{StaticResource Card}" Padding="28,26" Background="#1A1E26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Style="{StaticResource EnterAnimation}">
            <TextBlock Style="{StaticResource Caption}" Text="אודות" HorizontalAlignment="Center" />
            <Border Width="72" Height="72" CornerRadius="{StaticResource Radius}" Background="{StaticResource AccentSoftBrush}"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconMark}" Width="40" Height="40" StrokeThickness="1.6" />
            </Border>
            <TextBlock Style="{StaticResource H2}" Text="תזמון הפעלה מחדש" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock x:Name="VersionText" Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Body}" Text="פותח על ידי ישראל בורוכוב · IB-Fix" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,16,0,0" />

            <Button HorizontalAlignment="Center" Margin="0,8,0,0" Cursor="Hand" ToolTip="פתח את האתר" Click="OnOpenWebsite">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Link" Text="ib-fix.com" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" FlowDirection="LeftToRight" Padding="4,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Link" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Link" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Style="{StaticResource Caption}" Text="© 2026 ישראל בורוכוב. כל הזכויות שמורות." HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,16,0,0" />
            <Button Content="סגור" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0"
                    IsDefault="True" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Border>
</Window>
