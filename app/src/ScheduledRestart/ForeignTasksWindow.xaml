<Window x:Class="ScheduledRestart.ForeignTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="תזמונים נוספים במחשב" Width="600" Height="620"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource TextBrush}" Background="{StaticResource WindowBackground}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="22,16,22,16" Style="{StaticResource EnterAnimation}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="תזמונים נוספים במחשב" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="משימות הפעלה מחדש או כיבוי שנוצרו מחוץ לתוכנה (כלי אחר, schtasks, PowerShell או ידנית)." />
        </StackPanel>

        <ScrollViewer x:Name="ListScroller" Grid.Row="1" Margin="0,14,0,10" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="TaskList" />
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource Dim}" FontSize="16" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Text="לא נמצאו תזמונים נוספים במחשב" Visibility="Collapsed" />

        <Grid Grid.Row="2">
            <TextBlock x:Name="FooterText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,140,0" />
            <Button x:Name="CloseButton" Content="סגור" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
