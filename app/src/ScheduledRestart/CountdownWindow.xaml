<Window x:Class="ScheduledRestart.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="הפעלה מחדש" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextBrush}">
    <Border Margin="18" Style="{StaticResource Card}" Padding="28" Background="#1A1E26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Style="{StaticResource EnterAnimation}">
            <Grid Width="176" Height="176" HorizontalAlignment="Center">
                <Ellipse Stroke="#262B35" StrokeThickness="10" />
                <Path x:Name="RingArc" Stroke="{StaticResource AccentBrush}" StrokeThickness="10"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" FlowDirection="LeftToRight" />
                <TextBlock x:Name="SecondsText" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="CountdownText" Style="{StaticResource H2}" FontSize="19" TextAlignment="Center" Margin="0,22,0,0" />
            <TextBlock Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" Margin="0,8,0,0"
                       Text="שמרו את העבודה הפתוחה. ניתן לבטל עד לסיום הספירה." />
            <Button x:Name="CancelButton" Style="{StaticResource PrimaryButton}" Content="בטל הפעלה מחדש"
                    Margin="0,22,0,0" HorizontalAlignment="Stretch" IsDefault="True" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </Border>
</Window>
